# Plantilla de configuración. Cópiala a .env y captura los valores reales:
#     cp .env.example .env
# El archivo .env no se versiona: trae credenciales.

PORT=3001

# ---------------------------------------------------------------------
# Base de datos principal (iniciativas_inesle). El sistema NO levanta un
# contenedor de base de datos: se conecta a un servidor MariaDB que ya opera.
#
# DB_HOST según dónde esté el servidor:
#   host.docker.internal   MariaDB en esta misma máquina y el backend en Docker
#   localhost               MariaDB en esta misma máquina y el backend con npm
#   10.0.0.25 / mi-servidor  servidor de red (pon su IP o su nombre)
# ---------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=iniciativas_inesle

# ---------------------------------------------------------------------
# Base de datos externa compartida de identidad corporativa (users_safs,
# s_usuario, s_users). Es la misma que usan los demás sistemas internos
# (SIAdministracion, SITickets, etc.) para autenticar por RFC.
# ---------------------------------------------------------------------
SAF_DB_HOST=host.docker.internal
SAF_DB_PORT=3306
SAF_DB_USER=root
SAF_DB_PASS=
SAF_DB_NAME=saf

# Secreto de firma del token. Genéralo con: openssl rand -base64 48
JWT_SECRET=si-inesle-secret-2025

# Origen(es) permitidos por CORS, separados por coma si son varios.
CORS_ORIGIN=http://localhost:4201
